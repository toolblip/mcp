{
  "name": "@toolblip/mcp",
  "version": "0.1.1",
  "mcpName": "com.toolblip/mcp",
  "description": "Use Toolblip developer tools directly from Claude Code and other MCP-compatible AI clients",
  "homepage": "https://toolblip.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toolblip/mcp.git"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "toolblip-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "toolblip",
    "claude",
    "claude-code",
    "developer-tools"
  ],
  "author": "Harun R Rayhan",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.4",
    "typescript": "^5.4.0",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
